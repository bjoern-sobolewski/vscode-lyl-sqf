{
  "fileTypes": [
    "sqf"
  ],
  "name": "sqf",
  "patterns": [
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "expression": {
      "patterns": [
        {
          "include": "#preprocessor"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#array-literal"
        },
        {
          "include": "#paren-expression"
        },
        {
          "include": "#block"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "begin": "^[ \\t]*(#\\s*include)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.include.sqf"
            }
          },
          "end": "(?<![\\\\\\r])(?=\\r?\\n)",
          "name": "meta.preprocessor.include.sqf",
          "patterns": [
            {
              "begin": "<",
              "end": ">",
              "name": "string.quoted.other.include.sqf"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#comments"
            }
          ]
        },
        {
          "begin": "^[ \\t]*(#\\s*define)\\b[ \\t]+([A-Za-z_][A-Za-z_0-9]*)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.define.sqf"
            },
            "2": {
              "name": "variable.other.constant.macro.sqf"
            }
          },
          "end": "(?<![\\\\\\r])(?=\\r?\\n)",
          "name": "meta.preprocessor.define.sqf",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#numbers"
            },
            {
              "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b",
              "name": "variable.parameter.preprocessor.sqf"
            }
          ]
        },
        {
          "begin": "^[ \\t]*(#\\s*(?:if|ifdef|ifndef|elif|else|endif|undef|pragma|line))\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.sqf"
            }
          },
          "end": "(?<![\\\\\\r])(?=\\r?\\n)",
          "name": "meta.preprocessor.sqf",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#numbers"
            },
            {
              "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b",
              "name": "variable.other.constant.macro.sqf"
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.sqf"
        },
        {
          "match": "//.*$",
          "name": "comment.line.sqf"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.sqf",
          "patterns": [
            {
              "match": "\"\"",
              "name": "constant.character.escape.quote.sqf"
            },
            {
              "match": "%[0-9]+",
              "name": "constant.other.placeholder.sqf"
            }
          ],
          "applyEndPatternLast": true
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.sqf",
          "patterns": [
            {
              "match": "''",
              "name": "constant.character.escape.quote.sqf"
            },
            {
              "match": "%[0-9]+",
              "name": "constant.other.placeholder.sqf"
            }
          ],
          "applyEndPatternLast": true
        }
      ]
    },
    "numbers": {
      "match": "(?<![\\w.])(?:0[xX][0-9a-fA-F]+|\\$[0-9a-fA-F]+|(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?)(?![\\w.])",
      "name": "constant.numeric.sqf"
    },
    "boolean-literal": {
      "match": "(?i)\\b(?:false|true)\\b",
      "name": "constant.language.boolean.sqf"
    },
    "null-literal": {
      "match": "(?i)\\b(null|nil|controlNull|displayNull|grpNull|locationNull|netObjNull|objNull|scriptNull|taskNull|teamMemberNull|configNull)\\b",
      "name": "constant.language.null.sqf"
    },
    "reserved-literal": {
      "match": "(?i)\\b(this|_this|_x|_y|_forEachIndex|_exception|_thisScript|_thisFSM|thisList|thisTrigger|west|east|resistance|civilian|independent|blufor|opfor)\\b",
      "name": "variable.language.reserved.sqf"
    },
    "access-modifier": {
      "match": "(?i)\\bprivate\\b",
      "name": "storage.modifier.sqf"
    },
    "control-statement": {
      "match": "(?i)\\b(goto|forEachReversed|to|breakTo|uiSleep|then|execVM|from|breakWith|scriptDone|scopeName|fileExists|assert|with|sleep|throw|continue|forEachMemberAgent|while|continueWith|halt|else|catch|forEachMemberTeam|switch|step|exit|do|execFSM|breakOut|canSuspend|exec|loadFile|waitUntil|try|break|case|call|:|spawn|terminate|scriptName|forEachMember|exitWith|for|default|forEach|isUIContext|if)\\b",
      "name": "keyword.control.sqf"
    },
    "code-managers": {
      "match": "(?i)\\b(?:compileFinal|compile|callExtension)\\b",
      "name": "support.function.sqf"
    },
    "operators": {
      "match": "==|!=|>=|<=|&&|\\|\\||[=!<>:+*/%^#-]",
      "name": "keyword.operator.sqf"
    },
    "array-literal": {
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": {
          "name": "meta.brace.square.sqf"
        }
      },
      "endCaptures": {
        "0": {
          "name": "meta.brace.square.sqf"
        }
      },
      "name": "meta.array-literal.sqf",
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    "paren-expression": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "meta.brace.paren.sqf"
        }
      },
      "endCaptures": {
        "0": {
          "name": "meta.brace.paren.sqf"
        }
      },
      "name": "meta.paren-expression.sqf",
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    "block": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "meta.brace.curly.sqf"
        }
      },
      "endCaptures": {
        "0": {
          "name": "meta.brace.curly.sqf"
        }
      },
      "name": "meta.block.sqf",
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    "vObject-statements": {
      "match": "(?i)\\b(?:player|cursorTarget)\\b",
      "name": "variable.language.vobject.sqf"
    },
    "identifiers": {
      "comment": "Anchor classification at the next identifier so large command alternatives never search the rest of a line. A zero-width identifier context avoids capture retokenization copying long prefixes.",
      "begin": "\\b(?=[A-Za-z_])",
      "end": "(?![A-Za-z_0-9])",
      "patterns": [
        {
          "match": "\\G(?:(?i:\\b(call|spawn)\\b)[ \\t]+([A-Za-z_][A-Za-z_0-9]*)\\b|\\b([A-Za-z_][A-Za-z_0-9]*)\\b(?=\\s*=\\s*(?:\\{|(?i:compile(?:Final)?)\\b))|((?i:\\b(?:false|true)\\b))|((?i:\\b(?:null|nil|controlNull|displayNull|grpNull|locationNull|netObjNull|objNull|scriptNull|taskNull|teamMemberNull|configNull)\\b))|((?i:\\b(?:this|_this|_x|_y|_forEachIndex|_exception|_thisScript|_thisFSM|thisList|thisTrigger|west|east|resistance|civilian|independent|blufor|opfor)\\b))|((?i:\\b(?:player|cursorTarget)\\b))|((?i:\\bprivate\\b))|((?i:\\b(?:goto|forEachReversed|to|breakTo|uiSleep|then|execVM|from|breakWith|scriptDone|scopeName|fileExists|assert|with|sleep|throw|continue|forEachMemberAgent|while|continueWith|halt|else|catch|forEachMemberTeam|switch|step|exit|do|execFSM|breakOut|canSuspend|exec|loadFile|waitUntil|try|break|case|call|:|spawn|terminate|scriptName|forEachMember|exitWith|for|default|forEach|isUIContext|if)\\b))|((?i:\\b(?:compileFinal|compile|callExtension)\\b))|((?i:\\b(?:and|or|not)\\b))|((?i:\\b(?:addWeaponWithAttachmentsCargoGlobal|calculatePlayerVisibilityByFriendly|addPublicVariableEventHandler|addWeaponWithAttachmentsCargo|allowCuratorLogicIgnoreAreas|canTriggerDynamicSimulation|cancelSimpleTaskDestination|currentMagazineDetailTurret|ctrlRemoveAllEventHandlers|ctrlSetFontHeightSecondary|addCuratorEditableObjects|addUserActionEventHandler|angularVelocityModelSpace|clearAllItemsFromBackpack|ctrlSetTextColorSecondary|clearBackpackCargoGlobal|clearMagazineCargoGlobal|ctrlSetTooltipColorShade|curatorCameraAreaCeiling|curatorRegisteredObjects|activeTitleEffectParams|camConstuctionSetParams|createMPCampaignDisplay|ctrlAnimationPhaseModel|ctrlParentControlsGroup|ctrlSetAutoScrollRewind|ctrlSetTooltipColorText|addBackpackCargoGlobal|addMagazineCargoGlobal|addMissionEventHandler|addSecondaryWeaponItem|clearKillConfirmations|clearWeaponCargoGlobal|commandSuppressiveFire|createHashMapFromArray|createSoundSourceLocal|ctrlRemoveEventHandler|ctrlSetAutoScrollD