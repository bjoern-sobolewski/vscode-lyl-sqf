{
  "scopeName": "config",
  "fileTypes": [
    "ext",
    "cpp",
    "hpp",
    "inc",
    "sqm",
    "rvmat",
    "fsm",
    "bikb",
    "bisurf"
  ],
  "name": "arma-config",
  "patterns": [
    {
      "include": "#preprocessor"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "name": "meta.class.declaration.arma_config",
      "match": "(?i)\\b(class)\\s+([A-Za-z_][A-Za-z_0-9]*)(?:\\s*:\\s*([A-Za-z_][A-Za-z_0-9]*))?",
      "captures": {
        "1": {
          "name": "storage.type.arma_config"
        },
        "2": {
          "name": "entity.name.class.arma_config"
        },
        "3": {
          "name": "entity.other.inherited-class.arma_config"
        }
      }
    },
    {
      "match": "(?i)\\b(?:delete|enum)\\b",
      "name": "keyword.control.arma_config"
    },
    {
      "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b(?=\\s*(?:\\[\\])?\\s*=)",
      "name": "variable.other.property.arma_config"
    },
    {
      "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b(?=\\s*\\()",
      "name": "entity.name.function.preprocessor.arma_config"
    }
  ],
  "repository": {
    "preprocessor": {
      "patterns": [
        {
          "begin": "^[ \\t]*(#\\s*include)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.include.arma_config"
            }
          },
          "end": "(?<![\\\\\\r])(?=\\r?\\n)",
          "name": "meta.preprocessor.include.arma_config",
          "patterns": [
            {
              "begin": "<",
              "end": ">",
              "name": "string.quoted.other.include.arma_config"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#comments"
            }
          ]
        },
        {
          "begin": "^[ \\t]*(#\\s*define)\\b[ \\t]+([A-Za-z_][A-Za-z_0-9]*)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.define.arma_config"
            },
            "2": {
              "name": "variable.other.constant.macro.arma_config"
            }
          },
          "end": "(?<![\\\\\\r])(?=\\r?\\n)",
          "name": "meta.preprocessor.define.arma_config",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#numbers"
            },
            {
              "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b",
              "name": "variable.parameter.preprocessor.arma_config"
            }
          ]
        },
        {
          "begin": "^[ \\t]*(#\\s*(?:if|ifdef|ifndef|elif|else|endif|undef|pragma|line))\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.arma_config"
            }
          },
          "end": "(?<![\\\\\\r])(?=\\r?\\n)",
          "name": "meta.preprocessor.arma_config",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#numbers"
            },
            {
              "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b",
              "name": "variable.other.constant.macro.arma_config"
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.arma_config"
        },
        {
          "match": "//.*$",
          "name": "comment.line.arma_config"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.arma_config",
          "patterns": [
            {
              "match": "\"\"",
              "name": "constant.character.escape.quote.arma_config"
            },
            {
              "match": "%[0-9]+",
              "name": "constant.other.placeholder.arma_config"
            }
          ],
          "applyEndPatternLast": true
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.arma_config",
          "patterns": [
            {
              "match": "''",
              "name": "constant.character.escape.quote.arma_config"
            },
            {
              "match": "%[0-9]+",
              "name": "constant.other.placeholder.arma_config"
            }
          ],
          "applyEndPatternLast": true
        }
      ]
    },
    "numbers": {
      "match": "(?<![\\w.])(?:0[xX][0-9a-fA-F]+|\\$[0-9a-fA-F]+|(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?)(?![\\w.])",
      "name": "constant.numeric.arma_config"
    }
  }
}
